{
  "name": "@friendzone/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "worker": "tsx --env-file-if-exists=../../.env src/jobs/worker.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "@friendzone/game-engine": "*",
    "@friendzone/shared": "*",
    "@prometheus-io/client": "^0.16.1",
    "bullmq": "^6.3.7",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.1.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  }
}
