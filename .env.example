# ---------------------------------------------------------------------------
# FriendZone environment. Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- HTTP / WebSocket server -----------------------------------------------
PORT=8080
HOST=0.0.0.0
# Comma-separated origins allowed to call the API and open a WebSocket.
CORS_ORIGINS=http://localhost:5174
# Public origin handed to clients when they ask for a shareable room link.
PUBLIC_WEB_ORIGIN=http://localhost:5174

# --- Identity ---------------------------------------------------------------
# HMAC key for player session tokens. 32+ random bytes, base64 or hex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-secret-change-me-0000000000
SESSION_TTL_SECONDS=86400

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgres://friendzone:friendzone@localhost:55432/friendzone
PG_POOL_MAX=10

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6380
# Key prefix lets several environments share one Redis instance.
REDIS_PREFIX=fz

# --- Gameplay tuning --------------------------------------------------------
# How long a disconnected player keeps their seat and score.
PLAYER_GRACE_SECONDS=45
# Idle lobby expiry and finished-room retention.
ROOM_LOBBY_TTL_SECONDS=1800
ROOM_FINISHED_TTL_SECONDS=900
# Scheduler tick for server-authoritative deadlines.
SCHEDULER_TICK_MS=250

# --- Rate limits (token bucket: capacity / refill per second) ---------------
RL_ROOM_CREATE=5:0.1
RL_ROOM_JOIN=20:0.5
RL_WS_ACTION=30:10

# --- Admin ------------------------------------------------------------------
# Bearer token for /admin/* endpoints. Empty disables the admin API entirely.
ADMIN_TOKEN=

# --- Content pipeline (optional; a committed sample dataset works offline) --
# Wikimedia asks for a descriptive UA with contact info on its APIs.
WIKIMEDIA_USER_AGENT=FriendZone/1.0 (https://github.com/you/friendzone; you@example.com)
